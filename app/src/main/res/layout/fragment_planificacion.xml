<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Planificación"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_planificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@color/turquesa_oscuro"
            app:tabSelectedTextColor="@color/turquesa_oscuro"
            app:tabTextColor="?attr/colorOnSurfaceVariant">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presupuestos" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metas de Ahorro" />
        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_planificacion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="100dp" />

            <!-- EL ESTADO VACÍO (Oculto por defecto) -->
            <LinearLayout
                android:id="@+id/layout_empty_planificacion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_empty_planificacion"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_coin"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:alpha="0.4"/>

                <TextView
                    android:id="@+id/tv_empty_titulo_planificacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Sin presupuestos"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tv_empty_sub_planificacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Empieza a tomar el control de tu dinero. ¡Crea un límite y no te pases este mes!"
                    android:textAlignment="center"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:alpha="0.8" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fab_agregar_plan"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Nuevo Presupuesto"
        android:textColor="?attr/colorOnSurface"
        android:padding="16dp"
        app:backgroundTint="@color/turquesa_dinamico"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_coin"
        app:iconSize="26dp"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconTint="?attr/colorOnSurface" />

</FrameLayout>